# Variables d'environnement (à définir dans Vercel → Project → Settings → Environment Variables,
# ou dans .env.local pour le dev). Ne jamais commiter de vraies valeurs.

# Code d'accès facultatif, saisi dans Réglages : l'IA sans quota (pour la famille). Sans code, l'IA est gratuite
# avec un petit quota par téléphone et par jour (api/parse.ts, api/recipes.ts), et les rappels sont ouverts à tous.
SILLAGE_ACCESS_CODE=

# --- Saisie rapide par IA ---
ANTHROPIC_API_KEY=
# Modèle optionnel (défaut : claude-opus-5-5).
# SILLAGE_MODEL=
# Modèle de l'offre gratuite, sans code d'accès (défaut : le même). Ex. claude-haiku-5-5 pour en réduire le coût.
# SILLAGE_FREE_MODEL=

# --- Notifications push ---
# Générer avec : pnpm dlx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@example.com
# Secret du cron d'envoi des rappels (appel : Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# Redis (posées automatiquement par l'intégration Upstash de Vercel). Sans elles en dev : stockage en mémoire.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
